<mujoco model="dual_panda_scene">
  <include file="dual_panda.xml"/>

  <option gravity="0 0 -9.81"/>
  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <body name="target_left" pos="0 0 0.5" quat="1 0 0 0" mocap="true">
      <geom type="sphere" size="0.012" contype="0" conaffinity="0"
            rgba="0.2 0.6 1.0 0.5"/>
    </body>
    <body name="target_right" pos="0 0 0.5" quat="1 0 0 0" mocap="true">
      <geom type="sphere" size="0.012" contype="0" conaffinity="0"
            rgba="1.0 0.5 0.0 0.5"/>
    </body>

    <body name="simple_table" pos="0 -0.35 0">
      <geom type="box" size="0.25 0.20 0.01" pos="0 0 0.25"
            rgba="0.85 0.75 0.55 1" contype="1" conaffinity="1"/>
      <geom type="box" size="0.015 0.015 0.125" pos=" 0.22  0.17 0.125"
            rgba="0.6 0.5 0.4 1" contype="1" conaffinity="1"/>
      <geom type="box" size="0.015 0.015 0.125" pos="-0.22  0.17 0.125"
            rgba="0.6 0.5 0.4 1" contype="1" conaffinity="1"/>
      <geom type="box" size="0.015 0.015 0.125" pos=" 0.22 -0.17 0.125"
            rgba="0.6 0.5 0.4 1" contype="1" conaffinity="1"/>
      <geom type="box" size="0.015 0.015 0.125" pos="-0.22 -0.17 0.125"
            rgba="0.6 0.5 0.4 1" contype="1" conaffinity="1"/>
    </body>

    <body name="cube_object" pos="0.08 -0.35 0.285">
      <joint name="cube_joint" type="free"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025"
            rgba="0.9 0.15 0.1 1" contype="1" conaffinity="1"
            friction="2.0 0.005 0.0001"/>
    </body>

  </worldbody>
</mujoco>
